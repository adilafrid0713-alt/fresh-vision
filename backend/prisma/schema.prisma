generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections     Inspection[]
  marketProducts  MarketProduct[]
  marketOrders    MarketOrder[]
  marketReviews   MarketReview[]
  marketMessages  MarketMessage[]
  mediaFiles      MediaLibrary[]
  mediaFolders    MediaFolder[]
}

model Inspection {
  id                  String   @id @default(uuid())
  batchId             String
  foodType            String
  metricsJson         String
  defectsJson         String
  detectedItemsJson   String
  rawImageUrl         String
  spoilageDataJson    String?
  aiPricingJson       String?
  timestamp           DateTime @default(now())
  
  // Optional userId if we want to link it
  userId              String?
  user                User?    @relation(fields: [userId], references: [id])

  @@index([timestamp(sort: Desc)])
  @@index([foodType, batchId])
  @@index([userId])
}

// --------------------------------------------------------------------
// FRESH MARKET MODULE
// --------------------------------------------------------------------

model MarketCategory {
  id          String          @id @default(uuid())
  name        String
  description String?
  products    MarketProduct[]
}

model MarketProduct {
  id                String   @id @default(uuid())
  sellerId          String
  seller            User     @relation(fields: [sellerId], references: [id])
  categoryId        String
  category          MarketCategory @relation(fields: [categoryId], references: [id])
  
  title             String
  description       String
  quantity          Float
  unit              String
  originalPrice     Float
  sellingPrice      Float
  minOrderQuantity  Float    @default(1)
  expiryDate        DateTime
  
  // AI Generated / Auto-filled
  freshnessScore    Int?
  qualityGrade      String?
  
  // Location
  pickupAvailable   Boolean  @default(true)
  homeDelivery      Boolean  @default(false)
  village           String?
  district          String?
  state             String?
  pinCode           String?
  
  // Contact Details
  contactPhone      String?
  contactEmail      String?
  contactWhatsApp   String?
  
  // Status
  status            String   @default("active") // active, paused, sold, deleted
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  images            MarketImage[]
  bookmarks         MarketBookmark[]
  views             MarketView[]
  orders            MarketOrder[]
  reviews           MarketReview[]

  @@index([status, categoryId])
  @@index([freshnessScore])
  @@index([sellerId])
  @@index([createdAt(sort: Desc)])
}

model MarketImage {
  id          String        @id @default(uuid())
  productId   String
  product     MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  isPrimary   Boolean       @default(false)
  createdAt   DateTime      @default(now())
}

model MarketBookmark {
  id          String        @id @default(uuid())
  userId      String
  productId   String
  product     MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([userId, productId])
}

model MarketView {
  id          String        @id @default(uuid())
  productId   String
  product     MarketProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewerId    String?
  createdAt   DateTime      @default(now())
}

model MarketOrder {
  id          String        @id @default(uuid())
  buyerId     String
  buyer       User          @relation(fields: [buyerId], references: [id])
  productId   String
  product     MarketProduct @relation(fields: [productId], references: [id])
  quantity    Float
  totalPrice  Float
  status      String        @default("pending") // pending, accepted, completed, cancelled
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MarketReview {
  id          String        @id @default(uuid())
  reviewerId  String
  reviewer    User          @relation(fields: [reviewerId], references: [id])
  productId   String
  product     MarketProduct @relation(fields: [productId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime      @default(now())
}

model MarketMessage {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  receiverId  String
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// --------------------------------------------------------------------
// MEDIA LIBRARY MODULE
// --------------------------------------------------------------------

model MediaFolder {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  name        String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  files       MediaLibrary[]
}

model MediaLibrary {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  folderId        String?
  folder          MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  
  url             String
  filename        String
  sizeBytes       Int
  mimeType        String
  
  // AI/OCR Metadata
  foodName        String?
  freshnessScore  Int?
  aiGrade         String?
  ocrText         String?
  barcodeData     String?
  
  source          String       @default("upload") // upload, camera, analysis
  isDeleted       Boolean      @default(false)
  deletedAt       DateTime?
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tags            MediaTag[]

  @@index([userId, isDeleted])
  @@index([folderId])
}

model MediaTag {
  id          String         @id @default(uuid())
  name        String         @unique
  files       MediaLibrary[]
}
