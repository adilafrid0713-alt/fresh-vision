# ==========================================
# FRESHVISION AI - ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# FRONTEND-SAFE VARIABLES (Can be exposed to browser)
# ------------------------------------------
# API URL for frontend to connect to backend
VITE_API_URL="/api"
# Google AI Vision API Key
VITE_GOOGLE_API_KEY="your-google-ai-key-here"

# ------------------------------------------
# SERVER-ONLY SECRETS (DO NOT EXPOSE TO BROWSER)
# ------------------------------------------
# PostgreSQL Database Connection String
DATABASE_URL="postgresql://user:password@host:port/database"
# Supabase Project URL
SUPABASE_URL="https://your-project-id.supabase.co"
# Supabase API Key (Service or Anon)
SUPABASE_ANON_KEY="your-supabase-anon-key-here"
# JWT Authentication Secret
JWT_SECRET="generate-a-strong-random-secret-here"

# (Optional) Allowed Frontend Domain for CORS
FRONTEND_URL="https://freshvision-demo.vercel.app"
